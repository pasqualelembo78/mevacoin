[Unit]
Description=MevaCoin Daemon (seed3 - 87.106.233.72 - ultra-lite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mevacoin/build/Linux/mevacoin/release/bin
ExecStart=/root/mevacoin/build/Linux/mevacoin/release/bin/mevacoind     --non-interactive     --data-dir /root/.mevacoin     --p2p-bind-ip 0.0.0.0     --p2p-bind-port 18080     --rpc-bind-ip 0.0.0.0     --rpc-bind-port 18081     --confirm-external-bind     --add-peer 82.165.218.56:18080 --add-peer 87.106.40.193:18080     --prune-blockchain --max-txpool-weight 50000000 --block-sync-size 5 --batch-max-weight 5 --mining-threads 1     --rpc-max-connections 10     --rpc-max-connections-per-private-ip 10     --log-level 2

Restart=always
RestartSec=10
TimeoutStopSec=60
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
KillMode=control-group

[Install]
WantedBy=multi-user.target
